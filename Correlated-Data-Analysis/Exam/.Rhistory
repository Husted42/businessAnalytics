rats <- rats_short %>%
pivot_longer(starts_with("y"), names_to = "Week", values_to = "Value") %>%
mutate(Week = as.numeric(sub("y", "", Week))) %>%
arrange(Rat, Week) %>%
{
left_join(
filter(., Week != 0),
filter(., Week == 0) %>% select(Rat, Trt, InitWheight = Value),
by = c("Rat", "Trt")
)
} %>%
mutate(
WeekQ = Week,
Week = factor(paste0("y", Week)),
Rat  = factor(Rat),
Trt  = factor(Trt),
InitWheight = as.numeric(InitWheight),
Gain = as.numeric(Value)
) %>%
select(Rat, Trt, Week, WeekQ, InitWheight, Gain)
ggplot(rats, aes(x = Week, y = Gain, color = Trt, group = Rat)) +
geom_line(alpha = 0.3) +
geom_point() +
labs(title = "Weight Gain of Rats Over Weeks by Treatment",
x = "Week",
y = "Weight Gain") +
theme_minimal()
